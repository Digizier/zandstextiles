# Public Client Configuration (Required for Next.js static export build)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ADMIN_PIN=your-strong-admin-password

# Server-Only Credentials for Setup/Seed CLI Scripts (Never expose to client or commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
ASSET_SOURCE_DIR=path/to/source-assets
